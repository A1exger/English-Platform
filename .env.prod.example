# Copy to .env.prod and fill in. Used by docker-compose.prod.yml.

# --- Database / cache ---
POSTGRES_USER=linguadesk
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=linguadesk

# --- Auth (generate long random values, e.g. `openssl rand -hex 32`) ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Web <-> API (single domain: frontend + API under /api) ---
# Public URL of the API as seen by the browser (used both for CORS and baked
# into the web client at build time).
CORS_ORIGIN=https://englishsparkstudio.com
NEXT_PUBLIC_API_URL=https://englishsparkstudio.com/api/v1

# Optional FIXED time zone for the UI ("today", the schedule, timestamps).
# Leave empty (the default) so each viewer sees dates in their own browser zone —
# international students each see their local time, like Google Calendar. Set it to
# force ONE zone for everyone regardless of their browser, e.g. Europe/Moscow.
APP_TIMEZONE=

# --- Reverse proxy / TLS (only needed with docker-compose.caddy.yml) ---
DOMAIN=englishsparkstudio.com
ACME_EMAIL=admin@englishsparkstudio.com

# Allow creating admin accounts via /auth/register (keep empty/false in prod;
# admins are created by the seed). Set to "true" only for controlled bootstraps.
ALLOW_ADMIN_REGISTRATION=

# --- Payments (optional for first deploy) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_SECRET=

# --- Video (LiveKit) ---
# The lesson-room video call is already wired end to end — you only need a
# LiveKit server + these 3 values. No code changes and no rebuild: the API reads
# them at runtime, so `docker compose ... up -d` (restart) is enough to apply.
#
# Fastest & free: LiveKit Cloud (cloud.livekit.io) — create a project, then copy
#   Project URL  ->  LIVEKIT_URL        (looks like wss://<name>.livekit.cloud)
#   API Key      ->  LIVEKIT_API_KEY
#   API Secret   ->  LIVEKIT_API_SECRET
# The free tier comfortably covers 1-on-1 and small (up to ~5) lessons.
# (For heavy group use you can self-host livekit-server instead — same 3 vars.)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Notifications ---
# Every event (new homework, tutor feedback, a submitted homework, a payment
# awaiting confirmation, a credited payment) is delivered in-app, by email and —
# when the user has linked a chat — to Telegram. Each channel is optional: leave
# it unset and that route is quietly skipped, the in-app bell still works.
#
# Telegram: create a bot with @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=

# Email (SMTP). Without SMTP_HOST no mail is sent.
# Gmail/Google Workspace: smtp.gmail.com, port 587, an *app password* as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
# "true" only for implicit TLS on port 465; leave empty for STARTTLS on 587.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="English Spark Studio <no-reply@example.com>"

# The API drains the notification queue every 30s by itself. Set to "off" to
# disable that (e.g. if you run an external worker).
NOTIFY_DISPATCH=

# --- AI course generation (optional; without a key generation is disabled) ---
ANTHROPIC_API_KEY=
# Model + concurrency for the generator (defaults are sensible).
ANTHROPIC_MODEL=claude-sonnet-5
AI_MAX_CONCURRENCY=3

# --- Western Union / MoneyGram (manual transfers) ---
TRANSFER_RECEIVER_NAME=LinguaDesk Ltd.
TRANSFER_RECEIVER_COUNTRY=Germany

# --- Prebuilt images from GHCR (only for docker-compose.ghcr.yml) ---
IMAGE_OWNER=a1exger/english-platform
IMAGE_TAG=latest
