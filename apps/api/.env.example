# Database
# Dev/test uses SQLite. PRODUCTION uses PostgreSQL, e.g.:
#   DATABASE_URL="postgresql://user:pass@host:5432/english_platform?schema=public"
DATABASE_URL="file:./dev.db"

# JWT
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Payments (Stripe + PayPal). Webhook secrets are used to verify signatures.
STRIPE_SECRET_KEY="sk_test_change_me"
STRIPE_WEBHOOK_SECRET="whsec_dev_change_me"
PAYPAL_CLIENT_ID="paypal-client-id"
PAYPAL_SECRET="paypal-secret"
PAYPAL_WEBHOOK_SECRET="paypal-webhook-secret-dev"

# Video (LiveKit Cloud)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret"

# Telegram bot (optional). Without a token, telegram notifications are skipped.
TELEGRAM_BOT_TOKEN=""

# AI course generation + wordlist translation (optional). Without a provider,
# these jobs fail cleanly. Pick ONE of the two backends:
#
# 1) Anthropic (Claude) directly:
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
#
# 2) Any OpenAI-compatible provider (takes precedence when set) — one key + a
#    base URL + a model. Examples:
#      OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1        AI_MODEL=anthropic/claude-3.5-sonnet
#      Gemini:      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=gemini-2.0-flash
#      Groq:        AI_BASE_URL=https://api.groq.com/openai/v1      AI_MODEL=llama-3.3-70b-versatile
#      Ollama:      AI_BASE_URL=http://ollama:11434/v1             AI_MODEL=llama3.1  AI_API_KEY=ollama
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
AI_MAX_CONCURRENCY="3"

# Western Union / MoneyGram receiver shown in transfer instructions.
TRANSFER_RECEIVER_NAME="LinguaDesk Ltd."
TRANSFER_RECEIVER_COUNTRY="Germany"
